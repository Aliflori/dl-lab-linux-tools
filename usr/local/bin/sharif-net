#!/usr/bin/env python3
"""Sharif Net: multiple accounts and session management."""

import getpass
import html
import ipaddress
import json
import os
import re
import runpy
import stat
import subprocess
import sys
import tempfile
import time
import urllib.parse
from pathlib import Path

import questionary
from rich.console import Console
from rich.panel import Panel
from rich.table import Table
from rich.text import Text
from rich import box

CORE = "/usr/local/lib/sharif-net/core.py"
console = Console()

UI_STYLE = questionary.Style([
    ("qmark", "fg:#56b6c2 bold"),
    ("question", "bold"),
    ("answer", "fg:#e5c07b bold"),
    ("pointer", "fg:#e5c07b bold"),
    ("highlighted", "fg:#21252b bg:#e5c07b bold"),
    ("selected", "fg:#e5c07b bold"),
    ("instruction", "fg:#89919f"),
    ("separator", "fg:#646c7a"),
    ("disabled", "fg:#646c7a italic"),
    ("current", "fg:#98c379 bold"),
    ("danger", "fg:#e06c75 bold"),
    ("muted", "fg:#89919f"),
    ("text", ""),
])


def heading(title, subtitle=None, clear=False):
    if clear:
        console.clear()

    console.print()

    console.print(
        Text("│ SHARIF NET", style="bold cyan")
    )

    console.print(
        Text(title, style="bold")
    )

    if subtitle:
        console.print(
            Text(subtitle, style="dim")
        )

    console.print()


def ui_choice(label, value, kind=None):
    if kind:
        return questionary.Choice(
            title=[(f"class:{kind}", label)],
            value=value
        )

    return questionary.Choice(
        title=label,
        value=value
    )


def select(message, choices):
    formatted = []

    for choice in choices:
        if isinstance(choice, str):
            if choice == "Back":
                choice = ui_choice(
                    "← Back", "Back", "muted"
                )

            elif choice == "Exit":
                choice = ui_choice(
                    "Exit", "Exit", "muted"
                )

            elif choice == "Disconnect ALL account sessions":
                choice = ui_choice(
                    "⚠ Disconnect ALL account sessions",
                    choice,
                    "danger"
                )

            elif choice == "Remove saved account":
                choice = ui_choice(
                    "Remove saved account",
                    choice,
                    "danger"
                )

        formatted.append(choice)

    return questionary.select(
        message,
        choices=formatted,
        pointer="❯",
        qmark="›",
        instruction="(↑/↓ Navigate · Enter Select)",
        style=UI_STYLE
    ).ask()


def confirm(message, default=False):
    return questionary.confirm(
        message,
        default=default,
        qmark="›",
        style=UI_STYLE
    )


def ask_text(message):
    return questionary.text(
        message,
        qmark="›",
        style=UI_STYLE
    )


def login_with_status(backend, username, password):
    with console.status(
        "[cyan]Signing in to Sharif portal...[/cyan]",
        spinner="dots"
    ):
        return portal_login(
            backend, username, password
        )


def source_ip():
    try:
        output = subprocess.check_output(
            ["ip", "-4", "route", "get", "1.1.1.1"],
            text=True, timeout=4
        )
        match = re.search(
            r"\bsrc\s+(\d+(?:\.\d+){3})", output
        )
        return match.group(1) if match else "unknown"
    except (OSError, subprocess.SubprocessError):
        return "unknown"


class Accounts:
    def __init__(self):
        self.path = (
            Path.home()
            / ".config/sharif-net/credentials.json"
        )

    def load(self):
        p = self.path

        if not p.exists() and not p.is_symlink():
            return []

        directory = p.parent.lstat()
        if (
            not stat.S_ISDIR(directory.st_mode)
            or directory.st_uid != os.getuid()
            or stat.S_IMODE(directory.st_mode) & 0o077
        ):
            raise PermissionError(
                "Credential directory must be private (700)"
            )

        fd = os.open(
            p,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        )

        with os.fdopen(fd, "r", encoding="utf-8") as f:
            st = os.fstat(f.fileno())

            if (
                not stat.S_ISREG(st.st_mode)
                or st.st_uid != os.getuid()
                or stat.S_IMODE(st.st_mode) & 0o077
                or st.st_nlink != 1
            ):
                raise PermissionError(
                    "Credential file must be private (600)"
                )

            data = json.load(f)

        # Compatibility with old one-account format
        if isinstance(data, dict) and "username" in data:
            data = {"accounts": [data]}

        records = (
            data.get("accounts")
            if isinstance(data, dict)
            else None
        )

        if not isinstance(records, list):
            raise ValueError("Invalid credential format")

        result = []

        for item in records:
            if (
                not isinstance(item, dict)
                or not isinstance(
                    item.get("username"), str
                )
                or not isinstance(
                    item.get("password"), str
                )
                or not item["username"]
                or not item["password"]
            ):
                raise ValueError("Invalid account entry")

            result.append({
                "username": item["username"],
                "password": item["password"]
            })

        names = {
            x["username"].casefold()
            for x in result
        }

        if len(names) != len(result):
            raise ValueError("Duplicate accounts")

        return result

    def save(self, records):
        p = self.path

        p.parent.mkdir(
            mode=0o700,
            parents=True,
            exist_ok=True
        )

        d = p.parent.lstat()

        if (
            not stat.S_ISDIR(d.st_mode)
            or d.st_uid != os.getuid()
            or stat.S_IMODE(d.st_mode) & 0o077
        ):
            raise PermissionError(
                "Private credential directory required"
            )

        self.load()

        fd, tmp = tempfile.mkstemp(
            prefix=".credentials-",
            dir=p.parent
        )

        try:
            os.fchmod(fd, 0o600)

            with os.fdopen(
                fd, "w", encoding="utf-8"
            ) as f:
                json.dump(
                    {
                        "version": 2,
                        "accounts": records
                    },
                    f,
                    ensure_ascii=False,
                    indent=2
                )

                f.write("\n")
                f.flush()
                os.fsync(f.fileno())

            os.replace(tmp, p)

        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)

    def set(self, username, password):
        records = self.load()

        records = [
            a for a in records
            if a["username"].casefold()
            != username.casefold()
        ]

        records.append({
            "username": username,
            "password": password
        })

        self.save(records)

    def remove(self, username):
        records = [
            a for a in self.load()
            if a["username"].casefold()
            != username.casefold()
        ]
        self.save(records)


def ask_credentials():
    heading(
        "Account credentials",
        "Your password will not be displayed."
    )

    username = ask_text(
        "Sharif username:"
    ).ask()

    if not username or not username.strip():
        return None

    password = getpass.getpass(
        "Sharif password: "
    )

    if not password:
        return None

    return username.strip(), password


def portal_login(backend, username, password):
    client = backend["Sharif"]()

    final, page = client.request(
        backend["LOGIN"]
    )

    parser = backend["PageText"]()
    parser.feed(page)

    if not parser.csrf:
        raise RuntimeError(
            "Portal CSRF token unavailable"
        )

    final, page = client.request(
        backend["LOGIN"],
        {
            "csrfmiddlewaretoken": parser.csrf,
            "username": username,
            "password": password
        }
    )

    parser = backend["PageText"]()
    parser.feed(page)

    if (
        urllib.parse.urlsplit(final).path
        != "/en-us/user/home/"
        or "User Information" not in parser.text
    ):
        raise RuntimeError(
            "Login was not confirmed"
        )

    match = re.search(
        r"\bWelcome\s+([\w.\-@]+)",
        parser.text
    )

    if (
        match
        and match.group(1).casefold()
        != username.casefold()
    ):
        raise RuntimeError(
            "Account identity mismatch"
        )

    client.account = (
        match.group(1) if match else username
    )

    client._login_password = password
    return client


def accounts_menu(store, backend):
    while True:
        records = store.load()

        heading(
            "Select account",
            f"{len(records)} saved account(s)"
        )

        choices = [
            questionary.Choice(
                a["username"] + "  ·  Saved",
                value=("use", i)
            )
            for i, a in enumerate(records)
        ]

        choices += [
            questionary.Choice(
                "Use a new account",
                value=("new", None)
            ),
            questionary.Choice(
                "Manage saved accounts",
                value=("manage", None)
            ),
            questionary.Choice(
                "Exit program",
                value=("exit", None)
            )
        ]

        choice = select(
            "Select Sharif account:",
            choices
        )

        if not choice or choice[0] == "exit":
            return None

        if choice[0] == "use":
            account = records[choice[1]]
            return (
                account["username"],
                account["password"]
            )

        if choice[0] == "new":
            credentials = ask_credentials()
            if credentials:
                return credentials

        if choice[0] == "manage":
            heading(
                "Manage saved accounts",
                "Add, update or remove local credentials."
            )

            action = select(
                "Manage saved accounts:",
                [
                    "Add / update account",
                    "Remove saved account",
                    "Back"
                ]
            )

            if action == "Add / update account":
                credentials = ask_credentials()

                if credentials:
                    username, password = credentials

                    try:
                        login_with_status(
                            backend,
                            username,
                            password
                        )

                        store.set(
                            username,
                            password
                        )

                        console.print(
                            "[green]Account verified "
                            "and saved.[/green]"
                        )

                    except Exception as exc:
                        console.print(
                            "[red]Save failed: "
                            f"{type(exc).__name__}[/red]"
                        )

            elif (
                action == "Remove saved account"
                and records
            ):
                username = select(
                    "Remove which account?",
                    [
                        a["username"]
                        for a in records
                    ]
                )

                if username and confirm(
                    f"Remove saved password for {username}?",
                    default=False
                ).ask():
                    store.remove(username)

                    console.print(
                        "[green]Saved password removed. "
                        "Portal sessions unchanged.[/green]"
                    )


def get_quota(client, backend):
    url = (
        backend["BASE"]
        + "/en-us/user/get_user_metadata/"
    )

    _, raw = client.request(
        url, ajax=True
    )

    data = json.loads(raw)

    if isinstance(data, str):
        data = json.loads(data)

    profiles = data.get("result", {})

    for profile in profiles.values():
        if not isinstance(profile, dict):
            continue

        name = str(
            profile.get("normal_username", "")
        )

        if name.casefold() == client.account.casefold():
            return float(profile["credit"]) / 1024

    return None


def active_sessions(client):
    sessions = client.get_sessions()

    if sessions is None:
        raise RuntimeError(
            "Portal session list unavailable"
        )

    return sessions


def show_sessions(client, own_ip, sessions):
    heading(
        "Active sessions",
        f"Account: {client.account}",
        clear=True
    )

    console.print(
        Text.assemble(
            ("Current IP: ", "dim"),
            (own_ip, "bold cyan")
        )
    )

    console.print(
        Text(
            f"{len(sessions)} active session(s)",
            style="dim"
        )
    )

    console.print()

    table = Table(
        box=box.ROUNDED,
        border_style="bright_black",
        header_style="bold cyan",
        expand=False,
        padding=(0, 1)
    )

    table.add_column("IP address", no_wrap=True)
    table.add_column("Login time")
    table.add_column("Status", no_wrap=True)

    for session in sessions:
        ip = str(
            session.get("session_ip", "?")
        )

        started = str(
            session.get("session_start_time")
            or session.get("login_date")
            or "-"
        )

        is_current = (
            own_ip != "unknown" and ip == own_ip
        )

        if is_current:
            table.add_row(
                Text(ip, style="bold green"),
                Text(started, style="green"),
                Text("★ CURRENT IP", style="bold green")
            )
        else:
            table.add_row(
                Text(ip),
                Text(started, style="dim"),
                Text("Other session", style="dim")
            )

    console.print(table)
    console.print()

    if not sessions:
        console.print(
            "[yellow]No active sessions.[/yellow]"
        )


def disconnect_params(client, backend, target_ip):
    """
    Build the verified per-session disconnect parameters.

    Portal session fields:
      ras_ip       -> ras
      session_ip   -> ip
      session_id   -> u_id

    Browser-captured disconnect request used user_id=0.
    """
    import ipaddress

    sessions = client.get_sessions()

    if sessions is None:
        return None

    matches = [
        s for s in sessions
        if str(s.get("session_ip", "")) == target_ip
    ]

    if len(matches) != 1:
        return None

    session = matches[0]

    ras = str(session.get("ras_ip") or "")
    sid = str(session.get("session_id") or "")
    account_user_id = session.get("user_id")

    try:
        ipaddress.IPv4Address(target_ip)
        ipaddress.IPv4Address(ras)
        if int(account_user_id) <= 0:
            return None
    except (ValueError, TypeError):
        return None

    if not re.fullmatch(r"[A-Fa-f0-9]{8,64}", sid):
        return None

    return {
        "user_id": "0",
        "ras": ras,
        "ip": target_ip,
        "u_id": sid,
    }



def disconnect_one(
    client,
    backend,
    sessions,
    own_ip
):
    if not sessions:
        return "[yellow]No sessions.[/yellow]"

    heading(
        "Disconnect one IP",
        f"Account: {client.account}",
        clear=True
    )

    console.print(
        Text.assemble(
            ("Your current IP: ", "dim"),
            (own_ip, "bold green")
        )
    )

    console.print(
        "[dim]Choose a session. "
        "Confirmation is required before disconnecting.[/dim]"
    )

    console.print()

    choices = []

    for i, session in enumerate(sessions):
        ip = str(session.get("session_ip", "?"))

        started = str(
            session.get("session_start_time")
            or session.get("login_date")
            or "-"
        )

        label = f"{ip:<15}  │  {started}"

        if own_ip != "unknown" and ip == own_ip:
            label += "  ★ CURRENT IP"

            choices.append(
                ui_choice(label, i, "current")
            )
        else:
            choices.append(
                ui_choice(label, i)
            )

    choices.append(
        ui_choice(
            "← Back", "back", "muted"
        )
    )

    index = select(
        "Choose a session:",
        choices
    )

    if index is None or index == "back":
        return None

    selected = sessions[index]
    target = str(
        selected.get("session_ip", "")
    )

    if sum(
        str(s.get("session_ip")) == target
        for s in sessions
    ) != 1:
        return (
            "[yellow]Duplicate IP entries; "
            "nothing disconnected.[/yellow]"
        )

    params = disconnect_params(
        client,
        backend,
        target
    )

    if params is None:
        return (
            "[yellow]Individual disconnect unavailable: "
            "the portal did not supply all four "
            "required parameters for this IP. "
            "No request was sent.[/yellow]"
        )

    console.print(
        f"[bold]Target IP:[/bold] {target}"
    )

    if target == own_ip:
        console.print(
            "[yellow]WARNING: This is the "
            "current source IP.[/yellow]"
        )

    if not confirm(
        "Disconnect ONLY this IP?",
        default=False
    ).ask():
        return "[dim]Cancelled.[/dim]"

    # Re-check the exact target before disconnecting.
    current = active_sessions(client)

    if sum(
        str(s.get("session_ip")) == target
        for s in current
    ) != 1:
        return (
            "[yellow]Session list changed; "
            "nothing disconnected.[/yellow]"
        )

    fresh = disconnect_params(
        client,
        backend,
        target
    )

    if fresh != params:
        return (
            "[yellow]Session ID changed; "
            "nothing disconnected.[/yellow]"
        )

    url = (
        backend["BASE"]
        + "/en-us/user/disconnect/?"
        + urllib.parse.urlencode(params)
    )

    client.request(
        url,
        ajax=True
    )

    for attempt in range(3):
        time.sleep(1)

        current = active_sessions(client)

        if not any(
            str(s.get("session_ip")) == target
            for s in current
        ):
            return (
                f"[green]Session {target} "
                "disappeared from portal list.[/green]"
            )

    return (
        "[yellow]Disconnect submitted. "
        "Verification pending.[/yellow]"
    )


def disconnect_all(client, backend, own_ip):
    sessions = active_sessions(client)

    if not sessions:
        return "[dim]No active sessions.[/dim]"

    show_sessions(
        client,
        own_ip,
        sessions
    )

    console.print(
        "[bold red]WARNING: This may disconnect "
        "ALL devices using this Sharif account!"
        "[/bold red]"
    )

    confirmed = confirm(
        "Disconnect ALL account sessions?",
        default=False
    ).ask()

    if not confirmed:
        return "[dim]Cancelled.[/dim]"

    phrase = ask_text(
        "Type DISCONNECT ALL:"
    ).ask()

    if phrase != "DISCONNECT ALL":
        return "[dim]Cancelled.[/dim]"

    client.request(
        backend["DISCONNECT"],
        {
            "user": client.account,
            "pass": client._login_password
        },
        ajax=True
    )

    return (
        "[yellow]Bulk disconnect submitted. "
        "Refresh sessions to verify.[/yellow]"
    )


def dashboard(client, backend, own_ip):
    heading(
        "Dashboard",
        "Account overview and connection management",
        clear=True
    )

    quota = None
    sessions = None

    with console.status(
        "[cyan]Loading account information...[/cyan]",
        spinner="dots"
    ):
        try:
            quota = get_quota(
                client, backend
            )
        except Exception:
            pass

        try:
            sessions = active_sessions(client)
        except Exception:
            pass

    active = (
        None if sessions is None
        else any(
            str(s.get("session_ip")) == own_ip
            for s in sessions
        )
    )

    if active is None:
        status = Text(
            "? Unknown", style="bold yellow"
        )

    elif active:
        status = Text(
            "● Connected", style="bold green"
        )

    else:
        status = Text(
            "○ Not reported", style="yellow"
        )

    remaining = (
        Text("Unavailable", style="yellow")
        if quota is None
        else Text(
            f"{quota:.3f} GB",
            style="bold green"
        )
    )

    details = Table.grid(
        padding=(0, 3)
    )

    details.add_column(
        style="dim",
        no_wrap=True
    )

    details.add_column()

    details.add_row(
        "Account",
        Text(client.account, style="bold")
    )

    details.add_row(
        "Remaining",
        remaining
    )

    details.add_row(
        "Source IP",
        Text(own_ip, style="bold cyan")
    )

    details.add_row(
        "Portal session",
        status
    )

    details.add_row(
        "Active sessions",
        Text(
            str(len(sessions))
            if sessions is not None
            else "Unknown"
        )
    )

    console.print(
        Panel.fit(
            details,
            title="[bold cyan]Account status[/bold cyan]",
            border_style="bright_black",
            padding=(1, 2)
        )
    )

    console.print()

    return sessions, active


def main():
    if not sys.stdin.isatty():
        console.print(
            "[red]Use an interactive terminal.[/red]"
        )
        return 1

    backend = runpy.run_path(
        CORE,
        run_name="sharif_net_backend"
    )

    store = Accounts()

    try:
        while True:
            choice = accounts_menu(
                store, backend
            )

            if choice is None:
                break

            username, password = choice

            try:
                client = login_with_status(
                    backend,
                    username,
                    password
                )
            except Exception as exc:
                console.print(
                    "[red]Login failed: "
                    f"{type(exc).__name__}[/red]"
                )
                continue

            saved = any(
                a["username"].casefold()
                == username.casefold()
                for a in store.load()
            )

            if not saved:
                console.print(
                    "[yellow]Saved passwords are plaintext "
                    "and protected by Linux file permissions."
                    "[/yellow]"
                )

                if confirm(
                    "Save this account?",
                    default=False
                ).ask():
                    store.set(
                        username,
                        password
                    )

            own_ip = source_ip()

            while True:
                try:
                    sessions, active = dashboard(
                        client,
                        backend,
                        own_ip
                    )

                    if (
                        active is False
                        and not backend[
                            "internet_reachable"
                        ]()
                    ):
                        if confirm(
                            "No internet for this IP. "
                            "Connect selected account?",
                            default=False
                        ).ask():
                            client.request(
                                backend["CONNECT"],
                                {
                                    "user": client.account,
                                    "pass": client._login_password
                                },
                                ajax=True
                            )

                            console.print(
                                "[green]Connect requested. "
                                "Refresh to verify.[/green]"
                            )

                    session_label = (
                        "Manage active sessions"
                        if sessions is None
                        else f"Manage active sessions ({len(sessions)})"
                    )

                    connect_label = (
                        "Connect this IP"
                        if active is not True
                        else "Connect this IP (session already active)"
                    )

                    action = select(
                        "Actions",
                        [
                            ui_choice(
                                "↻ Refresh quota and status",
                                "Refresh quota and status"
                            ),
                            ui_choice(
                                session_label,
                                "Show / manage active sessions"
                            ),
                            ui_choice(
                                connect_label,
                                "Connect this IP"
                            ),
                            ui_choice(
                                "Switch account",
                                "Switch account"
                            ),
                            ui_choice(
                                "Exit",
                                "Exit",
                                "muted"
                            )
                        ]
                    )

                    if action is None or action == "Exit":
                        return 0

                    if action == "Switch account":
                        break

                    if action == "Show / manage active sessions":
                        while True:
                            with console.status(
                                "[cyan]Loading active sessions...[/cyan]",
                                spinner="dots"
                            ):
                                rows = active_sessions(client)

                            show_sessions(
                                client,
                                own_ip,
                                rows
                            )

                            command = select(
                                "Session menu:",
                                [
                                    "Disconnect one IP",
                                    "Disconnect ALL account sessions",
                                    "Back"
                                ]
                            )

                            if command in (None, "Back"):
                                break

                            if command == "Disconnect one IP":
                                result = disconnect_one(
                                    client,
                                    backend,
                                    rows,
                                    own_ip
                                )

                                if result is None:
                                    continue

                                console.print(result)

                            else:
                                console.print(
                                    disconnect_all(
                                        client,
                                        backend,
                                        own_ip
                                    )
                                )

                            input("\nPress Enter to continue...")

                    if action == "Connect this IP":
                        heading(
                            "Connect this IP",
                            clear=True
                        )

                        details = Table.grid(
                            padding=(0, 2)
                        )

                        details.add_column(style="dim")
                        details.add_column()

                        details.add_row(
                            "Account",
                            Text(client.account, style="bold")
                        )

                        details.add_row(
                            "Target IP",
                            Text(own_ip, style="bold green")
                        )

                        console.print(
                            Panel.fit(
                                details,
                                border_style="cyan",
                                padding=(1, 2)
                            )
                        )

                        console.print()

                        if confirm(
                            f"Connect {client.account} "
                            f"from {own_ip}?",
                            default=False
                        ).ask():
                            client.request(
                                backend["CONNECT"],
                                {
                                    "user": client.account,
                                    "pass": client._login_password
                                },
                                ajax=True
                            )

                            console.print(
                                "[green]Connect request "
                                "submitted.[/green]"
                            )

                except (KeyboardInterrupt, EOFError):
                    break

                except Exception as exc:
                    console.print(
                        "[red]Operation failed: "
                        f"{type(exc).__name__}: "
                        f"{exc}[/red]"
                    )

    except (KeyboardInterrupt, EOFError):
        pass

    except (
        OSError,
        ValueError,
        PermissionError
    ) as exc:
        console.print(
            f"[red]Settings error: {exc}[/red]"
        )
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
